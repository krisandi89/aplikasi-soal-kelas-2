<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kuis Matematika Kelas 2 - Bangun Datar & Ruang</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .quiz-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 2rem;
            background-color: #f9fafb;
            border-radius: 1rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        .question-card {
            background-color: #ffffff;
            border-radius: 0.75rem;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .question-svg {
            width: 100px;
            height: 100px;
            margin: 0 auto 1rem auto;
            display: block;
        }
        .answer-textarea {
            width: 100%;
            min-height: 80px;
            border-radius: 0.5rem;
            border: 1px solid #d1d5db;
            padding: 0.75rem;
            font-size: 0.9rem;
            margin-top: 1rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .answer-textarea:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
            outline: none;
        }
        .submit-btn {
            width: 100%;
            padding: 0.75rem 1rem;
            font-size: 1rem;
            font-weight: 600;
            color: #ffffff;
            background-color: #3b82f6;
            border: none;
            border-radius: 0.5rem;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        .submit-btn:hover {
            background-color: #2563eb;
        }
        .result-card {
            background-color: #ffffff;
            border-radius: 0.75rem;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .correct-answer {
            background-color: #d1fae5;
            border: 1px solid #34d399;
            padding: 0.75rem;
            border-radius: 0.5rem;
            margin-top: 1rem;
            font-weight: 600;
        }
    </style>
</head>
<body class="bg-gray-100">

    <div class="quiz-container">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Kuis Matematika Kelas 2</h1>
        <p class="text-center text-gray-600 mb-8">Jawablah pertanyaan di bawah ini dengan jawabanmu sendiri!</p>

        <!-- Bagian Kuis -->
        <div id="quiz-section">
            <form id="quiz-form">
                <!-- Soal 1 -->
                <div class="question-card">
                    <p class="text-lg font-semibold mb-2">Soal 1</p>
                    <svg class="question-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <polygon points="50,10 90,90 10,90" fill="#f87171" stroke="#b91c1c" stroke-width="2"/>
                    </svg>
                    <p class="text-gray-700">Perhatikan gambar segitiga di atas. Ada berapa banyak sisi, sudut, dan titik sudutnya?</p>
                    <textarea id="q1" class="answer-textarea" placeholder="Tulis jawabanmu di sini..."></textarea>
                </div>

                <!-- Soal 2 -->
                <div class="question-card">
                    <p class="text-lg font-semibold mb-2">Soal 2</p>
                    <svg class="question-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <rect x="10" y="10" width="80" height="80" fill="#60a5fa" stroke="#1d4ed8" stroke-width="2"/>
                    </svg>
                    <p class="text-gray-700">Perhatikan gambar persegi di atas. Ada berapa banyak sisi, sudut, dan titik sudutnya?</p>
                    <textarea id="q2" class="answer-textarea" placeholder="Tulis jawabanmu di sini..."></textarea>
                </div>

                <!-- Soal 3 -->
                <div class="question-card">
                    <p class="text-lg font-semibold mb-2">Soal 3</p>
                    <svg class="question-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <polygon points="50,5 95,35 75,95 25,95 5,35" fill="#34d399" stroke="#047857" stroke-width="2"/>
                    </svg>
                    <p class="text-gray-700">Bangun datar yang memiliki 5 sisi disebut apa?</p>
                    <textarea id="q3" class="answer-textarea" placeholder="Tulis jawabanmu di sini..."></textarea>
                </div>

                <!-- Soal 4 -->
                <div class="question-card">
                    <p class="text-lg font-semibold mb-2">Soal 4</p>
                    <svg class="question-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <polygon points="25,10 75,10 95,50 75,90 25,90 5,50" fill="#facc15" stroke="#a16207" stroke-width="2"/>
                    </svg>
                    <p class="text-gray-700">Bangun datar yang memiliki 6 sisi disebut apa?</p>
                    <textarea id="q4" class="answer-textarea" placeholder="Tulis jawabanmu di sini..."></textarea>
                </div>

                <!-- Soal 5 -->
                <div class="question-card">
                    <p class="text-lg font-semibold mb-2">Soal 5</p>
                    <svg class="question-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <g>
                            <rect x="20" y="35" width="50" height="50" fill="#c084fc" stroke="#7e22ce" stroke-width="2"/>
                            <polygon points="20,35 70,35 90,15 40,15" fill="#c084fc" stroke="#7e22ce" stroke-width="2"/>
                            <polygon points="70,35 70,85 90,65 90,15" fill="#c084fc" stroke="#7e22ce" stroke-width="2"/>
                        </g>
                    </svg>
                    <p class="text-gray-700">Bangun ruang kubus memiliki berapa banyak sisi?</p>
                    <textarea id="q5" class="answer-textarea" placeholder="Tulis jawabanmu di sini..."></textarea>
                </div>

                <!-- Soal 6 -->
                <div class="question-card">
                    <p class="text-lg font-semibold mb-2">Soal 6</p>
                    <svg class="question-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                         <g>
                            <rect x="10" y="40" width="70" height="50" fill="#fbbf24" stroke="#b45309" stroke-width="2"/>
                            <polygon points="10,40 80,40 95,20 25,20" fill="#fbbf24" stroke="#b45309" stroke-width="2"/>
                            <polygon points="80,40 80,90 95,70 95,20" fill="#fbbf24" stroke="#b45309" stroke-width="2"/>
                        </g>
                    </svg>
                    <p class="text-gray-700">Bangun ruang balok memiliki berapa banyak rusuk?</p>
                    <textarea id="q7" class="answer-textarea" placeholder="Tulis jawabanmu di sini..."></textarea>
                </div>

                <!-- Soal 7 -->
                <div class="question-card">
                    <p class="text-lg font-semibold mb-2">Soal 7</p>
                    <svg class="question-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="40" fill="#f87171" stroke="#b91c1c" stroke-width="2"/>
                    </svg>
                    <p class="text-gray-700">Apa nama bangun ruang yang bentuknya seperti bola?</p>
                    <textarea id="q8" class="answer-textarea" placeholder="Tulis jawabanmu di sini..."></textarea>
                </div>

                <!-- Gambar Peta untuk Soal 8-10 -->
                <div class="question-card">
                    <p class="text-lg font-semibold mb-2 text-center">Perhatikan denah di bawah ini untuk menjawab Soal 8, 9, dan 10.</p>
                    <p class="text-sm text-gray-600 text-center mb-4">(Posisi kanan dan kiri dilihat oleh pembaca)</p>
                    <svg class="w-full h-auto" viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg">
                        <!-- Jalan -->
                        <rect x="10" y="60" width="180" height="10" fill="#d1d5db"/>
                        <rect x="10" y="120" width="180" height="10" fill="#d1d5db"/>
                        <rect x="40" y="70" width="10" height="50" fill="#d1d5db"/>
                        <rect x="95" y="70" width="10" height="50" fill="#d1d5db"/>
                        <rect x="150" y="70" width="10" height="50" fill="#d1d5db"/>
                        
                        <!-- Bangunan Atas: Sekolah -->
                        <rect x="60" y="10" width="80" height="40" fill="#f87171" stroke="#b91c1c" stroke-width="1"/>
                        <text x="100" y="35" font-family="Inter, sans-serif" font-size="10" fill="#1f2937" text-anchor="middle">Sekolah</text>
                        
                        <!-- Bangunan Bawah -->
                        <!-- Rumah Fira (Kiri) -->
                        <rect x="10" y="80" width="50" height="30" fill="#60a5fa" stroke="#1d4ed8" stroke-width="1"/>
                        <text x="35" y="100" font-family="Inter, sans-serif" font-size="8" fill="#1f2937" text-anchor="middle">Rumah Fira</text>

                        <!-- Taman Bermain (Tengah) -->
                        <rect x="75" y="80" width="50" height="30" fill="#34d399" stroke="#047857" stroke-width="1"/>
                        <text x="100" y="100" font-family="Inter, sans-serif" font-size="8" fill="#1f2937" text-anchor="middle">Taman</text>

                        <!-- Toko Roti (Kanan) -->
                        <rect x="140" y="80" width="50" height="30" fill="#facc15" stroke="#a16207" stroke-width="1"/>
                        <text x="165" y="100" font-family="Inter, sans-serif" font-size="8" fill="#1f2937" text-anchor="middle">Toko Roti</text>
                    </svg>
                </div>

                <!-- Soal 8 (Baru) -->
                <div class="question-card">
                    <p class="text-lg font-semibold mb-2">Soal 8</p>
                    <p class="text-gray-700">Berdasarkan denah, apa yang ada di depan Sekolah?</p>
                    <textarea id="q9" class="answer-textarea" placeholder="Tulis jawabanmu di sini..."></textarea>
                </div>
                
                <!-- Soal 9 (Baru) -->
                <div class="question-card">
                    <p class="text-lg font-semibold mb-2">Soal 9</p>
                    <p class="text-gray-700">Berdasarkan denah, apa yang ada di sebelah kiri Taman?</p>
                    <textarea id="q6" class="answer-textarea" placeholder="Tulis jawabanmu di sini..."></textarea>
                </div>

                <!-- Soal 10 (Baru) -->
                <div class="question-card">
                    <p class="text-lg font-semibold mb-2">Soal 10</p>
                    <p class="text-gray-700">Berdasarkan denah, Toko Roti terletak di sebelah kanan apa?</p>
                    <textarea id="q10" class="answer-textarea" placeholder="Tulis jawabanmu di sini..."></textarea>
                </div>

                <button type="button" id="submit-button" class="submit-btn">
                    Selesai!
                </button>
            </form>
        </div>

        <!-- Bagian Hasil -->
        <div id="result-section" class="hidden">
            <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">Kunci Jawaban</h2>
            <p class="text-center text-gray-600 mb-8">Bagus sekali! Kamu sudah menyelesaikan semua soal. Sekarang, minta orang tuamu untuk memeriksa jawabanmu dengan kunci jawaban di bawah ini ya.</p>

            <!-- Hasil Soal 1 -->
            <div class="result-card">
                <p class="text-lg font-semibold mb-2">Soal 1: Perhatikan gambar segitiga di atas. Ada berapa banyak sisi, sudut, dan titik sudutnya?</p>
                <p class="text-gray-700 font-medium">Jawabanmu:</p>
                <textarea id="r1" class="answer-textarea" readonly disabled></textarea>
                <div class="correct-answer">
                    Kunci Jawaban: Memiliki 3 sisi, 3 sudut, dan 3 titik sudut.
                </div>
            </div>
            
            <!-- Hasil Soal 2 -->
            <div class="result-card">
                <p class="text-lg font-semibold mb-2">Soal 2: Perhatikan gambar persegi di atas. Ada berapa banyak sisi, sudut, dan titik sudutnya?</p>
                <p class="text-gray-700 font-medium">Jawabanmu:</p>
                <textarea id="r2" class="answer-textarea" readonly disabled></textarea>
                <div class="correct-answer">
                    Kunci Jawaban: Memiliki 4 sisi, 4 sudut, dan 4 titik sudut.
                </div>
            </div>

            <!-- Hasil Soal 3 -->
            <div class="result-card">
                <p class="text-lg font-semibold mb-2">Soal 3: Bangun datar yang memiliki 5 sisi disebut apa?</p>
                <p class="text-gray-700 font-medium">Jawabanmu:</p>
                <textarea id="r3" class="answer-textarea" readonly disabled></textarea>
                <div class="correct-answer">
                    Kunci Jawaban: Segi lima (atau Pentagon).
                </div>
            </div>
            
            <!-- Hasil Soal 4 -->
            <div class="result-card">
                <p class="text-lg font-semibold mb-2">Soal 4: Bangun datar yang memiliki 6 sisi disebut apa?</p>
                <p class="text-gray-700 font-medium">Jawabanmu:</p>
                <textarea id="r4" class="answer-textarea" readonly disabled></textarea>
                <div class="correct-answer">
                    Kunci Jawaban: Segi enam (atau Heksagon).
                </div>
            </div>

            <!-- Hasil Soal 5 -->
            <div class="result-card">
                <p class="text-lg font-semibold mb-2">Soal 5: Bangun ruang kubus memiliki berapa banyak sisi?</p>
                <p class="text-gray-700 font-medium">Jawabanmu:</p>
                <textarea id="r5" class="answer-textarea" readonly disabled></textarea>
                <div class="correct-answer">
                    Kunci Jawaban: Memiliki 6 sisi.
                </div>
            </div>
            
            <!-- Hasil Soal 6 -->
            <div class="result-card">
                <p class="text-lg font-semibold mb-2">Soal 6: Bangun ruang balok memiliki berapa banyak rusuk?</p>
                <p class="text-gray-700 font-medium">Jawabanmu:</p>
                <textarea id="r7" class="answer-textarea" readonly disabled></textarea>
                <div class="correct-answer">
                    Kunci Jawaban: Memiliki 12 rusuk.
                </div>
            </div>

            <!-- Hasil Soal 7 -->
            <div class="result-card">
                <p class="text-lg font-semibold mb-2">Soal 7: Apa nama bangun ruang yang bentuknya seperti bola?</p>
                <p class="text-gray-700 font-medium">Jawabanmu:</p>
                <textarea id="r8" class="answer-textarea" readonly disabled></textarea>
                <div class="correct-answer">
                    Kunci Jawaban: Bola.
                </div>
            </div>

            <!-- Hasil Soal 8 (Baru) -->
            <div class="result-card">
                <p class="text-lg font-semibold mb-2">Soal 8: Berdasarkan denah, apa yang ada di depan Sekolah?</p>
                <p class="text-gray-700 font-medium">Jawabanmu:</p>
                <textarea id="r9" class="answer-textarea" readonly disabled></textarea>
                <div class="correct-answer">
                    Kunci Jawaban: Taman.
                </div>
            </div>
            
            <!-- Hasil Soal 9 (Baru) -->
            <div class="result-card">
                <p class="text-lg font-semibold mb-2">Soal 9: Berdasarkan denah, apa yang ada di sebelah kiri Taman?</p>
                <p class="text-gray-700 font-medium">Jawabanmu:</p>
                <textarea id="r6" class="answer-textarea" readonly disabled></textarea>
                <div class="correct-answer">
                    Kunci Jawaban: Rumah Fira.
                </div>
            </div>
            
            <!-- Hasil Soal 10 (Baru) -->
            <div class="result-card">
                <p class="text-lg font-semibold mb-2">Soal 10: Berdasarkan denah, Toko Roti terletak di sebelah kanan apa?</p>
                <p class="text-gray-700 font-medium">Jawabanmu:</p>
                <textarea id="r10" class="answer-textarea" readonly disabled></textarea>
                <div class="correct-answer">
                    Kunci Jawaban: Taman.
                </div>
            </div>

            <button type="button" id="restart-button" class="submit-btn" style="background-color: #10b981; margin-top: 1rem;">
                Ulangi Kuis
            </button>
        </div>
    </div>

    <script>
        document.getElementById('submit-button').addEventListener('click', function() {
            // Salin jawaban ke bagian hasil
            document.getElementById('r1').value = document.getElementById('q1').value;
            document.getElementById('r2').value = document.getElementById('q2').value;
            document.getElementById('r3').value = document.getElementById('q3').value;
            document.getElementById('r4').value = document.getElementById('q4').value;
            document.getElementById('r5').value = document.getElementById('q5').value;
            document.getElementById('r6').value = document.getElementById('q6').value;
            document.getElementById('r7').value = document.getElementById('q7').value;
            document.getElementById('r8').value = document.getElementById('q8').value;
            document.getElementById('r9').value = document.getElementById('q9').value;
            document.getElementById('r10').value = document.getElementById('q10').value;

            // Sembunyikan kuis, tampilkan hasil
            document.getElementById('quiz-section').classList.add('hidden');
            document.getElementById('result-section').classList.remove('hidden');
            
            // Gulir ke atas
            window.scrollTo(0, 0);
        });

        document.getElementById('restart-button').addEventListener('click', function() {
            // Kosongkan semua jawaban
            const textareas = document.querySelectorAll('.answer-textarea');
            textareas.forEach(textarea => textarea.value = '');

            // Tampilkan kuis, sembunyikan hasil
            document.getElementById('quiz-section').classList.remove('hidden');
            document.getElementById('result-section').classList.add('hidden');
            
            // Gulir ke atas
            window.scrollTo(0, 0);
        });
    </script>

</body>
</html>
